<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>37b5a530-7ad5-494b-a983-ed80f60eb873</UserSecretsId>
    <!-- The version of record is frontend/package.json; a release build is stamped from it. This
         fallback only names a local build, and says "dev" so nobody mistakes it for a release. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaAcquisitionManager.Core\MediaAcquisitionManager.Core.csproj" />
    <ProjectReference Include="..\MediaAcquisitionManager.Infrastructure\MediaAcquisitionManager.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Pinned exactly, on the same patch as every other Microsoft.* package. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <!-- Pinned exactly. MAM-45 — the MCP endpoint (/mcp) for AI assistants: 2.x, as 1.4.1 is the last 1.x and gets
       critical fixes only; 2.x speaks both the initialize handshake Claude Code and mcp-remote use (2025-11-25) and
       the 2026-07-28 revision. Its Microsoft.Extensions.* dependencies are below the 10.0.12 pins, so nothing is
       downgraded. -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <!-- Design-time only (dotnet ef): PrivateAssets keeps Roslyn and the scaffolder out of the app's
       runtime dependencies. Same exact version as every other EF Core package. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- MAM-47 (ADR 0042) — the server's sentences, one file per area and language. Embedded, so the image, `dotnet run`
       and the tests read the same bytes and no file can be missing next to the DLL; removed from Content, so the Web SDK
       doesn't also publish them as loose files. -->
  <ItemGroup>
    <Content Remove="Locales\**\*.json" />
    <EmbeddedResource Include="Locales\**\*.json" LogicalName="Locales/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MediaAcquisitionManager.Api.Tests" />
    <InternalsVisibleTo Include="MediaAcquisitionManager.TestInfrastructure" />
  </ItemGroup>

</Project>
