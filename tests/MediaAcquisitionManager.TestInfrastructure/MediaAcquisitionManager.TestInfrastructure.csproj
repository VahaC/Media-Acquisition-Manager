<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared test support (the app factory, test databases, seeders, the test clock) — no tests
       live here, so the test runner must not treat it as a test project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MediaAcquisitionManager.Api\MediaAcquisitionManager.Api.csproj" />
    <ProjectReference Include="..\..\src\MediaAcquisitionManager.Core\MediaAcquisitionManager.Core.csproj" />
    <ProjectReference Include="..\..\src\MediaAcquisitionManager.Infrastructure\MediaAcquisitionManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
